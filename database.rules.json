{
  "rules": {
    ".read": true,
    ".write": true,
    "users": {
      ".indexOn": ["username", "googleId", "patientRef"]
    },
    "patients": {
      ".indexOn": ["createdAt", "name", "email"]
    },
    "teeth": {
      ".indexOn": ["patientId", "toothNumber"]
    },
    "treatments": {
      ".indexOn": ["patientId", "toothNumber", "date", "paid"]
    },
    "appointments": {
      ".indexOn": ["patientId", "date", "status", "time"]
    }
  }
}
